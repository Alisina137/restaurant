{
  "name": "dineflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @dineflow/api dev",
    "dev:web": "pnpm --filter @dineflow/web dev",
    "dev:mobile": "node scripts/dev-mobile-with-ngrok.mjs",
    "db:migrate": "pnpm --filter @dineflow/api db:migrate",
    "seed:dev": "pnpm --filter @dineflow/api seed:dev",
    "ui:verify": "node scripts/verify-design-system.mjs",
    "nav:verify": "node scripts/verify-workspace-navigation.mjs",
    "interaction:verify": "node scripts/verify-interactions.mjs",
    "auth:verify": "node scripts/verify-auth-ux.mjs",
    "dashboard:verify": "node scripts/verify-dashboard.mjs",
    "menu20:verify": "node scripts/verify-menu20.mjs",
    "floor21:verify": "node scripts/verify-floor21.mjs",
    "staff22:verify": "node scripts/verify-staff22.mjs",
    "mobile23:verify": "node scripts/verify-mobile23.mjs && pnpm --filter @dineflow/api exec tsx ../mobile/src/mobile23-ci.ts",
    "mobile24:verify": "node scripts/verify-mobile24.mjs && pnpm --filter @dineflow/api exec tsx ../mobile/src/mobile24-ci.ts",
    "mobile25:verify": "node scripts/verify-mobile25.mjs && pnpm --filter @dineflow/api exec tsx ../mobile/src/mobile25-ci.ts",
    "mobile26:verify": "node scripts/verify-mobile26.mjs && pnpm --filter @dineflow/api exec tsx ../mobile/src/mobile26-ci.ts",
    "kitchen27:verify": "node scripts/verify-kitchen27.mjs && pnpm --filter @dineflow/api exec tsx ../web/src/lib/kitchen27-ci.ts",
    "kitchen28:verify": "node scripts/verify-kitchen28.mjs && pnpm --filter @dineflow/api exec tsx ../web/src/lib/kitchen28-ci.ts && pnpm --filter @dineflow/api exec tsx ../mobile/src/mobile28-ci.ts",
    "kitchen29:verify": "node scripts/verify-kitchen29.mjs && pnpm --filter @dineflow/api exec tsx ../web/src/lib/kitchen29-ci.ts",
    "kitchen30:verify": "node scripts/verify-kitchen30.mjs && pnpm --filter @dineflow/api exec tsx ../web/src/lib/kitchen30-ci.ts",
    "kitchen31:verify": "node scripts/verify-kitchen31.mjs && pnpm --filter @dineflow/api exec tsx ../web/src/lib/kitchen31-ci.ts",
    "pilot32:verify": "node scripts/verify-pilot32.mjs && pnpm --filter @dineflow/api exec tsx ../web/src/lib/pilot32-ci.ts",
    "pilot33:verify": "node scripts/verify-pilot33.mjs && pnpm --filter @dineflow/api exec tsx ../web/src/lib/pilot33-ci.ts",
    "menu:stability:verify": "pnpm --filter @dineflow/api exec tsx src/menu-stability-ci.ts && pnpm --filter @dineflow/api exec tsx src/phase38-ci.ts && pnpm --filter @dineflow/api exec tsx src/phase39-ci.ts",
    "dev:interfaces:verify": "node scripts/verify-dev-launcher.mjs && pnpm --filter @dineflow/api exec tsx ../web/src/lib/dev-interface-launcher-ci.ts",
    "pilot31:rehearse": "pnpm --filter @dineflow/api exec tsx src/phase31-load.ts",
    "typecheck": "pnpm --filter @dineflow/shared typecheck && pnpm --filter @dineflow/api typecheck && pnpm --filter @dineflow/web typecheck && pnpm --filter @dineflow/mobile typecheck",
    "test": "pnpm --filter @dineflow/shared test && pnpm --filter @dineflow/api test",
    "build:web": "cross-env NODE_ENV=production pnpm --filter @dineflow/web build",
    "ops:rehearsal": "pnpm --filter @dineflow/api backup:rehearsal",
    "ops:preflight": "node scripts/release34-preflight.mjs",
    "ops:preflight:verify": "node --test scripts/release34-preflight.test.mjs",
    "dev:mobile:lan": "node scripts/dev-mobile-with-ngrok.mjs --lan",
    "mobile:tunnel:verify": "node --test scripts/dev-mobile-with-ngrok.test.mjs",
    "phase35:verify": "node scripts/verify-phase35.mjs && pnpm phase36:verify",
    "phase36:verify": "node scripts/verify-phase36.mjs && pnpm phase37:verify",
    "phase37:verify": "node scripts/verify-phase37.mjs && pnpm phase38:verify",
    "phase38:verify": "node scripts/verify-phase38.mjs && pnpm phase39:verify",
    "phase39:verify": "node scripts/verify-phase39.mjs",
    "phase40:verify": "node scripts/verify-phase40.mjs && pnpm --filter @dineflow/api exec tsx ../mobile/src/mobile40-ci.ts",
    "phase41:verify": "node scripts/verify-phase41.mjs && pnpm --filter @dineflow/api exec tsx ../web/src/lib/pilot41-ci.ts",
    "phase42:verify": "node scripts/verify-phase42.mjs"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
