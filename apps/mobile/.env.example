# Expo Go on a real phone CANNOT reach your computer's localhost.
# Use the public HTTPS ngrok API tunnel URL when testing on a device.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Required for mobile password-reset and verification emails when web is not the same LAN host.
# Must be a trusted PUBLIC browser-accessible DineFlow web origin (no trailing path).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
