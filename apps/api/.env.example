# Copy to apps/api/.env and set values locally. NEVER commit actual secrets.
DATABASE_URL=postgresql://user:password@localhost:5432/dineflow
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:4000
TRUSTED_ORIGINS=http://localhost:3000
PORT=4000
NODE_ENV=development
# Optional dev seed ONLY (never run on production):
DEMO_PASSWORD=
DEMO_OWNER_EMAIL=
DEMO_WAITER_EMAIL=
DEMO_KITCHEN_EMAIL=
DEMO_CASHIER_EMAIL=
DEMO_PLATFORM_EMAIL=
