# Copy to apps/api/.env. Do not commit live credentials.
DATABASE_URL=postgresql://user:password@localhost:5432/dineflow
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:4000
TRUSTED_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
PORT=4000
NODE_ENV=development
# Production email requires verified sender domain:
RESEND_API_KEY=
MAIL_FROM=
# Local-only testing: prints sensitive one-time links in API terminal. NEVER enable in production.
DEV_EMAIL_DELIVERY=console
# Proposed pilot trial length, not commercial billing:
TRIAL_DAYS=14
# Development seed only:
DEMO_PASSWORD=
DEMO_OWNER_EMAIL=
DEMO_WAITER_EMAIL=
DEMO_KITCHEN_EMAIL=
DEMO_CASHIER_EMAIL=
DEMO_PLATFORM_EMAIL=
