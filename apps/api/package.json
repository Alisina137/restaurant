{
  "name": "@dineflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "test:integration": "tsx src/e2e-ci.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "seed:dev": "tsx src/seed-dev.ts",
    "platform:grant": "tsx src/grant-platform-admin.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.25",
    "@better-auth/expo": "1.7.25",
    "@dineflow/shared": "workspace:*",
    "better-auth": "1.7.25",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
