# Use a DEVELOPMENT Neon database. Never commit real credentials.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# file writes mail to .local-mail during development only. Production requires smtp.
MAIL_MODE=file
MAIL_FROM=Restaurant Social <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Private S3-compatible bucket. Required only for restaurant photo uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Deploy behind a trusted proxy that OVERWRITES this header.
TRUSTED_IP_HEADER=x-real-ip
